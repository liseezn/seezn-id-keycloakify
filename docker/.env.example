# Copy to docker/.env and edit. NEVER commit docker/.env (real secrets).
# docker compose automatically reads .env from this directory (docker/).

# --- PostgreSQL -----------------------------------------------------------
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=replace-with-a-long-random-password

# --- Keycloak bootstrap admin (only used when the master realm is created) -
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-password

# --- Public origin --------------------------------------------------------
# Must match the external TLS hostname. Keycloak prints https URLs from this.
KC_HOSTNAME=https://auth.liseezn.top

# --- Images / build inputs ------------------------------------------------
# For Keycloak 26.8.2 use the "all other versions" JAR (not 22-to-25).
# Path is relative to the repository root (the Docker build context).
THEME_JAR=dist_keycloak/keycloak-theme-for-kc-all-other-versions.jar
SITE_IMAGE_TAG=1.0.0

# --- Listener -------------------------------------------------------------
# Host-side bind for the site container. Keep loopback-only and put your TLS
# terminator (host nginx/Caddy/Traefik) in front.
SITE_HTTP_BIND=127.0.0.1:8080

# Optional: debug logging (info|debug|trace).
KC_LOG_LEVEL=info
