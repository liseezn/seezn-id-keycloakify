# syntax=docker/dockerfile:1

# SeeZn ID public site + same-origin edge for Keycloak.
#
# Build from the repository root so both public-site/ and docker/nginx.conf are
# in the context:
#   docker build -f docker/Dockerfile.site -t seezn-id/site .
#
# public-site/ contains the three approved static pages (index.html, terms.html,
# privacy.html). It is plain HTML/CSS/JS on purpose: React is reserved for the
# Keycloak authentication theme shell.
FROM nginx:alpine

# Replace the stock server block. It serves the static pages and proxies
# /realms/, /resources/, /admin/, /js/ and /robots.txt to the keycloak service.
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY public-site/ /usr/share/nginx/html/

# Fail the image build on a broken nginx config instead of at runtime.
RUN nginx -t

EXPOSE 80
