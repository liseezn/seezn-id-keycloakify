{
    "name": "seezn-id-keycloakify",
    "version": "1.0.0",
    "description": "SeeZn ID Keycloakify login theme and static public pages",
    "repository": {
        "type": "git",
        "url": "https://github.com/liseezn/seezn-id-keycloakify.git"
    },
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "npm run typecheck && vite build",
        "build-keycloak-theme": "npm run build && keycloakify build",
        "storybook": "storybook dev -p 6006",
        "format": "prettier . --write",
        "typecheck": "tsc --noEmit",
        "test:e2e": "playwright test -c tests/e2e/playwright.config.ts",
        "lint": "eslint ."
    },
    "license": "MIT",
    "keywords": [],
    "dependencies": {
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@fontsource/inter": "^5.3.0",
        "@mui/material": "^6.5.0",
        "keycloakify": "^11.16.0",
        "lucide-react": "^1.77.0",
        "react": "^18.2.0",
        "react-dom": "^18.2.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.15.0",
        "@playwright/test": "^1.65.1",
        "@storybook/react": "^8.1.10",
        "@storybook/react-vite": "^8.1.10",
        "@types/node": "^26.6.6",
        "@types/react": "^18.2.43",
        "@types/react-dom": "^18.2.17",
        "@typescript-eslint/eslint-plugin": "^8.15.0",
        "@typescript-eslint/parser": "^8.15.0",
        "@vitejs/plugin-react": "^4.2.1",
        "eslint": "^9.15.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-react": "^7.37.2",
        "eslint-plugin-react-hooks": "^5.0.0",
        "eslint-plugin-react-refresh": "^0.4.14",
        "eslint-plugin-storybook": "^0.11.1",
        "globals": "^15.12.0",
        "prettier": "3.3.1",
        "smtp-server": "^3.21.7",
        "storybook": "^8.1.10",
        "typescript": "^5.2.2",
        "typescript-eslint": "^8.15.0",
        "vite": "^5.0.8",
        "playwright-core": "^1.65.1"
    },
    "engines": {
        "node": "^18.0.0 || >=20.0.0"
    }
}
